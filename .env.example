# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: the two NEXT_PUBLIC_ lines are shown ready to copy under Connect → Framework →
# Next.js → .env.local in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…): safe in the browser, limited by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…, Project Settings → API Keys): server only, bypasses
# row-level security. Never in the browser, never in chat.
SUPABASE_SECRET_KEY=

# The public address of the site (links in WhatsApp messages, Paystack callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later: Paystack test keys (M7), WhatsApp Cloud API (M5), CRON_SECRET for Vercel Cron.
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Tikka's WhatsApp number in international format (claim messages go to it). Until it's set,
# the claim button opens WhatsApp with the message and lets you pick the chat.
# NEXT_PUBLIC_TIKKA_WHATSAPP=+234...
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# CRON_SECRET=
# Optional: the key that signs card image links (/api/og/card). Defaults to one derived from SUPABASE_SECRET_KEY.
# OG_SIGNING_SECRET=
# Card and portfolio videos: set to off on the free Supabase plan (photos stay on).
# NEXT_PUBLIC_TIKKA_VIDEOS=off
# Bunny Stream for owners' videos (lib/stream.ts). Stream → your library → API: the Video Library
# ID, the CDN hostname, and the API Key (not the read-only one). Without them, videos go to Storage.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_CDN_HOST=
# BUNNY_STREAM_API_KEY=
# Pre-launch: only admins and a business's own team can claim; Notify me is closed. Lets a
# production build through with draft legal pages (scripts/check-legal.ts). Remove to open claims.
# TIKKA_PRELAUNCH=1
# While WhatsApp waits for Meta's verification: claim on the page with a typed number (lib/claim-mode.ts).
# Remove to claim on WhatsApp again.
# TIKKA_CLAIM_MODE=page
# Optional bot check for page claims (Cloudflare Turnstile). Set both or neither.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
